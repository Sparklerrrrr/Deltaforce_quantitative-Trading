# =============================================================================
# DFQ 的 .gitignore
# 原则：仓库里只有源码、模板、脚本、测试和文档；任何个人配置、密钥、运行数据、
# 缓存和构建产物都不进 Git。程序文件夹里各文件的归属见 dfq/layout.py。
# 注意：.gitignore 只对“还没被 Git 跟踪”的文件生效；已跟踪的文件要用 git rm --cached 移出。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 密钥与凭据（最重要）
# -----------------------------------------------------------------------------
# 真实的环境变量 / 密钥文件，以及 .env.local、.env.bak 等所有变体
.env
.env.*
*.env
# 唯一例外：不含任何真实值的模板，需要提交
!.env.example
# 证书、私钥、密钥库
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
id_rsa*
id_ed25519*
# 浏览器登录状态（moligod 等网站的 Cookie，等同凭据）
**/browser_profile/
**/moligod_profile/

# -----------------------------------------------------------------------------
# 2. 用户配置（每个人自己的设置；模板 config.example.yaml 要提交）
# -----------------------------------------------------------------------------
/config.yaml
/config.local.yaml

# -----------------------------------------------------------------------------
# 3. 运行时数据：数据库、交易记录、日志、缓存、临时文件、备份、界面数据
#    全部在程序文件夹的 data/ 下（源码运行时就是项目根目录的 data/）
# -----------------------------------------------------------------------------
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.eml
# 接口实测报告是用真实接口生成的运行产物（现在写到 data/reports/；旧版本写在 docs/ 下）
/docs/*实测*.md
# 手动粘贴的资讯原文（可能含群聊等个人内容）；只保留说明文件
/manual_notes/*
!/manual_notes/README.md

# -----------------------------------------------------------------------------
# 4. Python 运行与测试
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# -----------------------------------------------------------------------------
# 5. 构建产物与安装包（由 scripts/build_exe.bat 生成，可以随时重建）
# -----------------------------------------------------------------------------
/build/
/dist/
*.spec
*.exe
# 在项目根目录直接运行“文件夹版” DFQ.exe 时，旁边的程序文件夹
/_internal/
# 直接用 ISCC 编译时的默认输出目录；发布流程生成的校验文件、构建记录、扫描结果
/installer/Output/
/release/
SHA256SUMS.txt
build-info.txt
scan-*.json

# -----------------------------------------------------------------------------
# 6. 编辑器、IDE 与操作系统杂项
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# -----------------------------------------------------------------------------
# 7. 不属于本项目的本地参考资料
# -----------------------------------------------------------------------------
三角洲/
