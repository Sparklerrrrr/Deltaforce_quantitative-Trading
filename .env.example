# DFQ 本地密钥文件模板（这个模板里没有任何真实值，可以提交）。
#
# 用法：复制一份，改名为 .env（就放在这个文件夹里），在等号后面填上你的值。
#       也可以直接在 DFQ.exe 的“设置”页填写，程序会自动创建 .env。
# .env 已加入 .gitignore，不会被提交或上传。不要把 .env 发给别人、贴到群里或截图。
# 格式：一行一个 名字=值，等号两边不要加空格。不用的留空即可。
# 系统环境变量里如果也设置了同名的，以系统环境变量为准。

# 小涛查接口 token（必需）
DFQ_XTC_TOKEN=

# 邮箱发信授权码（开启邮件时需要；QQ 邮箱填“授权码”，不是登录密码）
DFQ_SMTP_PASSWORD=

# 邮箱收信授权码（一般不用填，默认与发信相同）
DFQ_IMAP_PASSWORD=

# 大模型 API Key（开启大模型时需要）
DFQ_LLM_API_KEY=

# 新闻搜索 Key（开启新闻搜索时需要）
DFQ_TAVILY_API_KEY=
